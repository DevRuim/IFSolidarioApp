<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bgdoacao">

    <!-- ════════════════════════════════════════
         PASSO 1 — Quantidade (ORIGINAL INTACTO)
         ════════════════════════════════════════ -->
    <ScrollView
        android:id="@+id/layoutPasso1"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:visibility="visible"
        tools:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="32dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="566dp"
                android:background="@drawable/bg_card_white_rounded"
                android:elevation="4dp"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_bold"
                    android:text="Primeiro passo:"
                    android:textColor="#7B2FBE"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvPerguntaCategoria"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="@font/poppins_regular"
                    android:text="Quantas roupas você está doando?"
                    android:textColor="#1A1A1A"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:layout_marginEnd="6dp"
                        android:text="ⓘ"
                        android:textColor="#7B2FBE"
                        android:textSize="16sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvInfoTitulo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_regular"
                            android:text="Itens aceitos (Qualquer tamanho e em bom estado):"
                            android:textColor="#333333"
                            android:textSize="13sp" />

                        <LinearLayout
                            android:id="@+id/layoutItensAceitos"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:id="@+id/colunaDireita"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvItem1"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:drawablePadding="4dp"
                                    android:fontFamily="@font/poppins_regular"
                                    android:text="• Camisetas"
                                    android:textColor="#333333"
                                    android:textSize="13sp" />

                                <TextView
                                    android:id="@+id/tvItem2"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/poppins_regular"
                                    android:text="• Calças"
                                    android:textColor="#333333"
                                    android:textSize="13sp" />
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/colunaEsquerda"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvItem3"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/poppins_regular"
                                    android:text="• Cobertores"
                                    android:textColor="#333333"
                                    android:textSize="13sp" />

                                <TextView
                                    android:id="@+id/tvItem4"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/poppins_regular"
                                    android:text="• Blusas"
                                    android:textColor="#333333"
                                    android:textSize="13sp" />
                            </LinearLayout>
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvDicaContagem"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:fontFamily="@font/poppins_regular"
                            android:text="Você pode doar vários itens\nde diferentes tipos\n(Ex. 2 blusas + 1 coberta = 3 itens )"
                            android:textColor="#333333"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="20dp"
                    android:background="#E0E0E0" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_bold"
                    android:text="Digite o número de itens:"
                    android:textColor="#7B2FBE"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/editQuantidade"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/edittext_background"
                    android:hint="3"
                    android:inputType="number"
                    android:paddingHorizontal="14dp"
                    android:textColor="#1A1A1A"
                    android:textColorHint="#AAAAAA"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/btnProximo"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_button_purple"
                    android:fontFamily="@font/poppins_bold"
                    android:text="Próximo"
                    android:textColor="@android:color/white"
                    android:textSize="16sp" />

                <Spinner
                    android:id="@+id/spinnerCategoria"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvSair"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="16dp"
                    android:fontFamily="@font/poppins_regular"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp"
                    android:text="Sair"
                    android:textColor="#7B2FBE"
                    android:textSize="15sp"
                    android:textStyle="bold" />

            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- ════════════════════════════════════════
         PASSO 2 — Fotos (REDESENHADO)
         ════════════════════════════════════════ -->
    <ScrollView
        android:id="@+id/layoutPasso2"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="28dp"
            android:paddingBottom="28dp">

            <!-- ── Card principal ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_white_rounded"
                android:elevation="6dp"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Cabeçalho: título + contador -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_bold"
                            android:text="Segundo passo:"
                            android:textColor="#7B2FBE"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/poppins_bold"
                            android:text="Fotos dos itens"
                            android:textColor="#1A1A1A"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Badge contador de fotos -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:background="@drawable/bg_badge_counter"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="5dp">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:src="@drawable/ic_photo"
                            app:tint="#7B2FBE" />

                        <TextView
                            android:id="@+id/tvContadorFotos"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:fontFamily="@font/poppins_bold"
                            android:text="0 / 5"
                            android:textColor="#7B2FBE"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </RelativeLayout>

                <!-- ── Dica em destaque ── -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_dica_box"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:text="💡"
                            android:textSize="14sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_bold"
                            android:text="Como fotografar bem:"
                            android:textColor="#5A1A9B"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Dicas visuais em linha -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <!-- Dica 1 -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/bg_dica_item"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="8dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="☀️"
                                android:textSize="22sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:fontFamily="@font/poppins_regular"
                                android:gravity="center"
                                android:text="Boa\niluminação"
                                android:textColor="#5A1A9B"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <View android:layout_width="6dp" android:layout_height="1dp" />

                        <!-- Dica 2 -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/bg_dica_item"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="8dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="📐"
                                android:textSize="22sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:fontFamily="@font/poppins_regular"
                                android:gravity="center"
                                android:text="Item no\ncentro"
                                android:textColor="#5A1A9B"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <View android:layout_width="6dp" android:layout_height="1dp" />

                        <!-- Dica 3 -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/bg_dica_item"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="8dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🖼️"
                                android:textSize="22sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:fontFamily="@font/poppins_regular"
                                android:gravity="center"
                                android:text="Fundo\nliso"
                                android:textColor="#5A1A9B"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- ── Carrossel de fotos ── -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Seta esquerda -->
                    <ImageButton
                        android:id="@+id/buttonPrev"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_arrow_circle"
                        android:contentDescription="Foto anterior"
                        android:padding="6dp"
                        android:src="@drawable/ic_arrow_left_line_foreground"
                        android:visibility="invisible"
                        app:tint="@android:color/white" />

                    <!-- Área central do carrossel -->
                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="200dp"
                        android:layout_marginHorizontal="8dp"
                        android:layout_weight="1">

                        <!-- Imagem principal -->
                        <ImageView
                            android:id="@+id/imagePreview"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_carousel_placeholder"
                            android:contentDescription="Foto da doação"
                            android:scaleType="centerCrop" />

                        <!-- Estado vazio (sem fotos) -->
                        <LinearLayout
                            android:id="@+id/layoutSemFotos"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="📷"
                                android:textSize="40sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:fontFamily="@font/poppins_regular"
                                android:gravity="center"
                                android:text="Nenhuma foto\nadicionada ainda"
                                android:textColor="#AAAAAA"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <!-- Overlay com número da foto atual -->
                        <TextView
                            android:id="@+id/tvPosicaoFoto"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom|end"
                            android:layout_margin="8dp"
                            android:background="@drawable/bg_foto_counter_pill"
                            android:fontFamily="@font/poppins_bold"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="3dp"
                            android:text="1/1"
                            android:textColor="@android:color/white"
                            android:textSize="11sp"
                            android:visibility="gone" />

                        <!-- Botão remover foto -->
                        <ImageButton
                            android:id="@+id/btnRemoverFoto"
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:layout_gravity="top|end"
                            android:layout_margin="8dp"
                            android:background="@drawable/bg_remove_btn"
                            android:contentDescription="Remover foto"
                            android:padding="5dp"
                            android:src="@drawable/ic_close"
                            android:visibility="gone"
                            app:tint="@android:color/white" />
                    </FrameLayout>

                    <!-- Seta direita -->
                    <ImageButton
                        android:id="@+id/buttonNext"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_arrow_circle"
                        android:contentDescription="Próxima foto"
                        android:padding="6dp"
                        android:src="@drawable/ic_arrow_right_line_foreground"
                        android:visibility="invisible"
                        app:tint="@android:color/white" />
                </LinearLayout>

                <!-- Indicadores de ponto (dots) -->
                <LinearLayout
                    android:id="@+id/layoutDots"
                    android:layout_width="wrap_content"
                    android:layout_height="8dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:orientation="horizontal" />

                <!-- ── Miniaturas (thumbnails) ── -->
                <HorizontalScrollView
                    android:id="@+id/scrollThumbnails"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:scrollbars="none"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/layoutThumbnails"
                        android:layout_width="wrap_content"
                        android:layout_height="60dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="2dp" />
                </HorizontalScrollView>

                <!-- ── Divisor ── -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="18dp"
                    android:layout_marginBottom="14dp"
                    android:background="#EBEBEB" />

                <!-- ── Botões de ação ── -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_bold"
                    android:text="Adicionar foto:"
                    android:textColor="#7B2FBE"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Botão câmera -->
                    <LinearLayout
                        android:id="@+id/addImageButton"
                        android:layout_width="0dp"
                        android:layout_height="64dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_btn_foto_outline"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:text="📷"
                            android:textSize="20sp" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/poppins_bold"
                                android:text="Câmera"
                                android:textColor="#7B2FBE"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/poppins_regular"
                                android:text="ou galeria"
                                android:textColor="#9B7DBE"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Botão DOAR -->
                    <Button
                        android:id="@+id/buttonFinalizar"
                        android:layout_width="0dp"
                        android:layout_height="64dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_button_purple"
                        android:fontFamily="@font/poppins_bold"
                        android:text="✓  DOAR"
                        android:textColor="@android:color/white"
                        android:textSize="17sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Aviso: foto opcional -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="10dp"
                    android:fontFamily="@font/poppins_regular"
                    android:gravity="center"
                    android:text="📌 A foto é opcional, mas ajuda a\nconfirmar a doação mais rápido."
                    android:textColor="#999999"
                    android:textSize="11sp" />

                <!-- IDs ocultos mantidos para compatibilidade com o Fragment -->
                <ImageButton
                    android:id="@+id/editImageButton"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/imagePreview2"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />

            </LinearLayout>

            <!-- Botão Voltar -->
            <TextView
                android:id="@+id/tvVoltar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="14dp"
                android:fontFamily="@font/poppins_regular"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:text="← Voltar"
                android:textColor="@android:color/white"
                android:textSize="15sp" />

        </LinearLayout>
    </ScrollView>

</FrameLayout>