<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bghome"
    tools:context=".ui.home.HomeFragment">

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="120dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- TOPO -->

            <FrameLayout
                android:id="@+id/totalDoacoesContainer"
                android:layout_width="match_parent"
                android:layout_height="156dp"
                android:paddingHorizontal="24dp">


                <!-- CONTEÚDO -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_bold"
                        android:text="Juntos já arrecadamos"
                        android:textColor="#FFFFFF"
                        android:textSize="26sp" />

                    <FrameLayout
                        android:layout_width="210dp"
                        android:layout_height="80dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_total_doacoes"
                        android:clipChildren="true"
                        android:clipToPadding="true">

                        <!-- PARTÍCULAS -->

                        <com.airbnb.lottie.LottieAnimationView
                            android:id="@+id/particlesAnimation"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:alpha="0.18"
                            android:scaleType="centerCrop"
                            android:visibility="gone"
                            app:lottie_autoPlay="true"
                            app:lottie_loop="true"
                            app:lottie_rawRes="@raw/particles" />

                        <com.airbnb.lottie.LottieAnimationView
                            android:id="@+id/loadingTotalDoacoes"
                            android:layout_width="80dp"
                            android:layout_height="80dp"
                            android:layout_gravity="center"
                            android:visibility="visible"
                            app:lottie_autoPlay="true"
                            app:lottie_loop="true"
                            app:lottie_rawRes="@raw/loading" />

                        <!-- NÚMERO -->

                        <TextView
                            android:id="@+id/textTotalDoacoes"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:fontFamily="@font/poppins_bold"
                            android:shadowColor="#80000000"
                            android:shadowDx="0"
                            android:shadowDy="2"
                            android:shadowRadius="6"
                            android:text="0"
                            android:textColor="#FFFFFF"
                            android:textSize="34sp"
                            android:textStyle="bold"
                            android:visibility="gone" />

                    </FrameLayout>

                    <!--<TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:fontFamily="@font/poppins_bold"
                        android:text="itens doados"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"/>-->


                </LinearLayout>

            </FrameLayout>

            <!-- LISTA -->

            <LinearLayout
                android:id="@+id/itemContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="32dp"/>

            <androidx.cardview.widget.CardView
                xmlns:android="http://schemas.android.com/apk/res/android"
                xmlns:app="http://schemas.android.com/apk/res-auto"
                xmlns:card_view="http://schemas.android.com/apk/res-auto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp"
                android:layout_marginBottom="12dp"
                card_view:cardCornerRadius="36dp"
                card_view:cardElevation="4dp"
                card_view:cardUseCompatPadding="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <!-- TÍTULO -->

                    <TextView
                        android:text="EM BREVE"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:fontFamily="@font/poppins_bold"
                        android:gravity="center"
                        android:textColor="#111111"
                        android:textSize="24sp" />

                    <!-- IMAGEM -->

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/embreve"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:src="@drawable/campanhaembreve"
                        android:adjustViewBounds="true"
                        android:scaleType="fitCenter"
                        android:layout_marginBottom="16dp"
                        app:shapeAppearanceOverlay="@style/RoundedImage"/>

                    <!-- DESCRIÇÃO -->

                    <TextView
                        android:text="Estamos trabalhando na próxima campanha... Aguardem!"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/poppins_regular"
                        android:lineSpacingExtra="3dp"
                        android:justificationMode="inter_word"
                        android:maxLines="5"
                        android:paddingHorizontal="6dp"
                        android:textColor="#444444"
                        android:textSize="15sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <!-- DATA -->

                        <TextView
                            android:text="Iniciará nos próximos dias"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_regular"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="7dp"
                            android:textColor="#444444"
                            android:textSize="13sp" />

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>


    </ScrollView>

    <FrameLayout
        android:id="@+id/loadingHome"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFFFF"
        android:clickable="true"
        android:focusable="true"
        android:elevation="10dp">

        <com.airbnb.lottie.LottieAnimationView
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="center"
            app:lottie_autoPlay="true"
            app:lottie_loop="true"
            app:lottie_rawRes="@raw/loading"/>

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>