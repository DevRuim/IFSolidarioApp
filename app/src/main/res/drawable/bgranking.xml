<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 1. Base roxa sólida -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#7B2FBE" />
        </shape>
    </item>

    <!-- 2. Faixa diagonal lilás (superior direita — profundidade) -->
    <item
        android:top="0dp"
        android:left="200dp"
        android:right="-120dp"
        android:bottom="500dp">
        <rotate
            android:fromDegrees="-38"
            android:pivotX="100%"
            android:pivotY="0%">
            <shape android:shape="rectangle">
                <solid android:color="#9B4FDE" />
                <size android:width="320dp" android:height="600dp" />
            </shape>
        </rotate>
    </item>

    <!-- 3. Triângulo amarelo — canto superior direito -->
    <item
        android:top="-260dp"
        android:left="180dp"
        android:right="-10dp"
        android:bottom="560dp">
        <rotate
            android:fromDegrees="45"
            android:pivotX="100%"
            android:pivotY="0%">
            <shape android:shape="rectangle">
                <solid android:color="#F5C518" />
            </shape>
        </rotate>
    </item>

    <!-- 4. Triângulo amarelo — canto inferior esquerdo -->
    <item
        android:top="560dp"
        android:left="-10dp"
        android:right="280dp"
        android:bottom="-260dp">
        <rotate
            android:fromDegrees="45"
            android:pivotX="0%"
            android:pivotY="100%">
            <shape android:shape="rectangle">
                <solid android:color="#F5C518" />
            </shape>
        </rotate>
    </item>

    <!-- 5. Véu lilás suave sobre a parte inferior (para o card branco encaixar bem) -->
    <item
        android:top="480dp"
        android:left="0dp"
        android:right="0dp"
        android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#5A1A9B" />
            <alpha android:value="0.25" />
        </shape>
    </item>

    <!-- 6. Losango decorativo — canto superior direito -->
    <item
        android:top="100dp"
        android:left="260dp"
        android:right="10dp"
        android:bottom="620dp">
        <rotate
            android:fromDegrees="45"
            android:pivotX="100%"
            android:pivotY="0%">
            <shape android:shape="rectangle">
                <solid android:color="#F5C518" />
                <size android:width="28dp" android:height="28dp" />
                <alpha android:value="0.30" />
            </shape>
        </rotate>
    </item>

    <!-- 7. Losango decorativo — canto inferior esquerdo -->
    <item
        android:top="580dp"
        android:left="10dp"
        android:right="260dp"
        android:bottom="100dp">
        <rotate
            android:fromDegrees="45"
            android:pivotX="0%"
            android:pivotY="100%">
            <shape android:shape="rectangle">
                <solid android:color="#F5C518" />
                <size android:width="22dp" android:height="22dp" />
                <alpha android:value="0.22" />
            </shape>
        </rotate>
    </item>

</layer-list>