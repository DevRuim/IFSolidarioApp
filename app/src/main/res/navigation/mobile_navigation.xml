<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_navigation"
    app:startDestination="@+id/navigation_home">

    <fragment
        android:id="@+id/navigation_home"
        android:name="com.ifpr.ifsolidarioapp.ui.home.HomeFragment"
        android:label="Home"
        tools:layout="@layout/fragment_home" />

    <!--
        DoacaoFragment → após salvar vai para o Ranking.
        popUpTo=navigation_home / inclusive=false:
        remove Doacao e qualquer tela acima da Home da pilha,
        mas MANTÉM a Home. Resultado: Home → Ranking.
    -->
    <fragment
        android:id="@+id/navigation_dashboard"
        android:name="com.ifpr.ifsolidarioapp.ui.doacao.DoacaoFragment"
        android:label="Doação"
        tools:layout="@layout/fragment_doacao">

        <action
            android:id="@+id/action_doacao_to_ranking"
            app:destination="@id/navigation_ranking"
            app:popUpTo="@id/navigation_home"
            app:popUpToInclusive="false"
            app:launchSingleTop="true" />

    </fragment>

    <fragment
        android:id="@+id/historicoFragment"
        android:name="com.ifpr.ifsolidarioapp.ui.usuario.HistoricoFragment"
        android:label="Historico" />

    <action
        android:id="@+id/action_profile_to_historico"
        app:destination="@id/historicoFragment" />

    <fragment
        android:id="@+id/navigation_ranking"
        android:name="com.ifpr.ifsolidarioapp.ui.ranking.RankingFragment"
        android:label="Ranking"
        tools:layout="@layout/ranking_fragment" />

    <fragment
        android:id="@+id/navigation_notifications"
        android:name="com.ifpr.ifsolidarioapp.ui.notifications.NotificationsFragment"
        android:label="Notifications"
        tools:layout="@layout/fragment_notifications" />

    <fragment
        android:id="@+id/navigation_profile"
        android:name="com.ifpr.ifsolidarioapp.ui.usuario.PerfilUsuarioFragment"
        android:label="Profile"
        tools:layout="@layout/fragment_perfil_usuario">

        <action
            android:id="@+id/action_profile_to_editarPerfil"
            app:destination="@id/navigation_editar_perfil" />

    </fragment>

    <fragment
        android:id="@+id/navigation_editar_perfil"
        android:name="com.ifpr.ifsolidarioapp.ui.usuario.EditarPerfilFragment"
        android:label="Editar Perfil"
        tools:layout="@layout/fragment_editar_perfil" />

</navigation>